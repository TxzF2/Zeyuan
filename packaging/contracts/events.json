{
  "version": 1,
  "naming": {
    "prefix": "zeyuan:",
    "template": "zeyuan:<board>:<action>",
    "actionPattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "note": "action 用动词过去式或名词短语（kebab-case）；禁止参数、冒号、大写"
  },
  "envelope": {
    "required": [
      "v",
      "id",
      "at",
      "source",
      "type",
      "payload"
    ],
    "optional": [
      "subject",
      "correlationId"
    ],
    "rules": [
      "payload 只放值，必须可 JSON 化（不带函数/循环引用/文件句柄）",
      "消费方必须幂等（按 id 去重），发布方不等待消费方",
      "消费失败不阻塞发布，写入 dead-letter.jsonl",
      "顺序只在同 source 内保证",
      "新增字段必须可选；删字段或改语义必须升 v"
    ]
  },
  "byBoard": {
    "core": [
      "settlement-requested",
      "settlement-done",
      "level-up",
      "coins-changed"
    ],
    "tasks": [
      "task-created",
      "task-claimed",
      "task-submitted",
      "task-accepted",
      "task-rejected",
      "reward"
    ],
    "feature-workbench": [
      "draft-opened",
      "draft-saved",
      "draft-published"
    ],
    "feature-community": [
      "post-drafted",
      "post-published",
      "post-liked",
      "post-hidden",
      "post-unhidden",
      "post-deleted",
      "comment-added",
      "comment-removed",
      "comment-hidden"
    ],
    "character-txzf": [
      "action-request"
    ],
    "character-changzhengji": [
      "action-request"
    ],
    "console": [
      "admin-granted",
      "admin-revoked",
      "scope-granted",
      "scope-revoked",
      "user-disabled",
      "board-toggled",
      "coins-granted",
      "dashboard-invalidate"
    ],
    "collab": [
      "group-formed",
      "member-joined",
      "member-left",
      "duty-changed",
      "group-activated",
      "task-assigned",
      "task-reassigned",
      "review-requested",
      "review-done",
      "coins-requested"
    ],
    "exchange": [
      "file-uploaded",
      "file-downloaded",
      "file-deleted",
      "file-expired",
      "file-orphan-swept"
    ]
  },
  "chains": [
    {
      "name": "任务验收 → 赏金结算 → 等级提升 → 仪表盘刷新",
      "steps": [
        "zeyuan:tasks:task-accepted",
        "zeyuan:tasks:reward",
        "zeyuan:core:settlement-requested",
        "zeyuan:core:settlement-done",
        "zeyuan:core:coins-changed",
        "zeyuan:core:level-up",
        "zeyuan:feature-console:dashboard-invalidate",
        "zeyuan:character-txzf:action-request"
      ]
    },
    {
      "name": "任务验收 → 工作台草稿 → 发布 → 社区帖子",
      "steps": [
        "zeyuan:tasks:task-accepted",
        "zeyuan:feature-workbench:draft-published",
        "zeyuan:feature-community:post-drafted",
        "zeyuan:feature-community:post-published"
      ]
    },
    {
      "name": "任务赏金入账 → 钱包流水",
      "steps": [
        "zeyuan:tasks:reward",
        "zeyuan:console:dashboard-invalidate"
      ]
    }
  ]
}
